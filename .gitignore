node_modules/
out/
cache/
# Anchored. Unanchored, this pattern also swallowed scripts/lib/somnia.ts — the one
# file every script imports its addresses from — and nobody noticed until CI could not
# typecheck a module that exists on every machine it was written on.
/lib/
broadcast/
.env
.probe-addr

.vercel
.env*
dist/
test-results/
playwright-report/
.impeccable/config.local.json
.impeccable/live/
# Decision-page server logs, one per served question. Local session state, not a record.
.impeccable/questions/
# docs/evidence/keeper-local.log is deliberately NOT ignored. The keeper's only real
# log lived on one machine and out of the repository, so the two days a slot sat frozen
# left no evidence anyone else could read. Every line in it carries a date now; commit it
# with the ledger. The GitHub half of the keeper uploads its own log as a run artifact.
keeper.log

# The film's raw materials: synthesised voice, filmed shots, the render itself. All of it
# is reproducible from video/script.mjs with `npm run video`, and none of it belongs in
# git at a few hundred megabytes. The subtitle track and the timing map are text and are
# kept — they are the record of what was said and when.
video/assets/*.mp3
video/assets/*.mp4
# Per-word timings from the synthesiser. Only useful next to their .mp3, which is not
# kept either; timing.json and the .srt are the readable record of the same thing.
video/assets/vo-*.json
video/assets/raw/
video/assets/_*
video/out/
video/render.log
.playwright-mcp/
forge-out/

# The framework's build cache. `out/` above is its static export.
.next/

# Generated by scripts/deployments.mjs at build time.
public/deployments.json

# Vercel CLI link and pulled settings.
.vercel/

# Written by the scheduled deploy retry.
docs/evidence/deploy-retry.log

# Progress chatter from the scheduled impact run; the measurement itself is committed.
docs/evidence/impact-2026-09-08.progress.txt

# Per-window verdicts kept so a killed impact run resumes instead of restarting. Working
# state, not evidence — the report it builds is what gets committed.
docs/evidence/impact.cache.json
