      "captions": [
        {
          "text": "Abadi is a market maker that survives its own",
          "start": 0.081,
          "end": 2.5
        },
        {
          "text": "markets expiring, a vault that settles itself when nobody",
          "start": 2.5,
          "end": 6.574041
        },
        {
          "text": "is watching, and a measurably tighter book for everyone",
          "start": 6.585666,
          "end": 9.594916
        },
        {
          "text": "else trading it.",
          "start": 9.594916,
          "end": 10.324082
        },
        {
          "text": "Every number you've seen is read from the chain —",
          "start": 10.694458,
          "end": 12.951416
        },
        {
          "text": "including the ones we'd rather not show you.",
          "start": 13.402791,
          "end": 15.428207
        }
      ],
